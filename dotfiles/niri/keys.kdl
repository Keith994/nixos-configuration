binds {
    // ── 系统 / 输入法 ──────────────────────────────────────────
    Mod+0 { spawn-sh "fcitx5 -r -d & disown"; }

    // ── 帮助 / 热键提示 ────────────────────────────────────────
    Mod+Shift+Slash { show-hotkey-overlay; }

    // ── 终端 ──────────────────────────────────────────────────
    // Mod+Return hotkey-overlay-title="Open a Terminal" { spawn-sh "ghostty +new-window -e ~/.local/bin/zellij_switch dev || ghostty -e ~/.local/bin/zellij_switch dev"; }
    // Mod+Return hotkey-overlay-title="Open a Kitty Terminal" { spawn-sh "ghostty +new-window"; }
    Mod+Return hotkey-overlay-title="Open a Terminal" { spawn-sh "ghostty +new-window -e tmux new-session -A -s main || ghostty -e  tmux new-session -A -s main"; }
    Mod+Shift+Return hotkey-overlay-title="Open a Kitty Terminal" { spawn-sh "kitty"; }
    Mod+Ctrl+Return hotkey-overlay-title="Open a Quick Terminal" { spawn-sh "ghostty +toggle-quick-terminal"; }

    // ── 音量 / 亮度（锁屏可用）────────────────────────────────
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "noctalia msg volume-down 3"; }
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "noctalia msg volume-up 3"; }
    XF86AudioMicMute allow-when-locked=true { spawn-sh "noctalia msg mic-mute"; }
    XF86AudioMute allow-when-locked=true { spawn-sh "noctalia msg volume-mute"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "noctalia msg brightness-down"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn-sh "noctalia msg brightness-up"; }

    // ── 窗口 / 布局 ───────────────────────────────────────────
    Mod+A hotkey-overlay-title="Over view" repeat=false { toggle-overview; }
    Mod+B hotkey-overlay-title="System Monitor" repeat=false { spawn-sh "footclient --app-id btop_terminal -- btop"; }
    Mod+C hotkey-overlay-title="Center Column" { center-column; }
    Mod+Shift+C hotkey-overlay-title="Center Visible Window Column" { center-visible-columns;}
    Mod+M hotkey-overlay-title="Maximize Column" { maximize-column; }
    Mod+Shift+M hotkey-overlay-title="FullScreen" { fullscreen-window; }
    Mod+F hotkey-overlay-title="Toggle Float" { spawn-sh "~/.config/niri/scripts/float.sh"; }
    Mod+O hotkey-overlay-title="Toggle Opacity" { toggle-window-rule-opacity; }
    Mod+Q hotkey-overlay-title="Close Window or Minimize to Tray" repeat=false { close-window; }

    // ── 列 / 窗口尺寸 ─────────────────────────────────────────
    Mod+R hotkey-overlay-title="Switch Column Width(0.333,0.667) Between Preset" { switch-preset-column-width; }
    Mod+Shift+R hotkey-overlay-title="Switch Column Preset Height(0.333,0.667,1.0) Between Preset" { switch-preset-window-height; }
    Mod+Minus hotkey-overlay-title="Decrease column width by 10%" { set-column-width "-10%"; }
    Mod+Equal hotkey-overlay-title="Increase column width by 10%" { set-column-width "+10%"; }
    Mod+Shift+Minus hotkey-overlay-title="Decrease column height by 10%" { set-window-height "-10%"; }
    Mod+Shift+Equal hotkey-overlay-title="Increase column height by 10%" { set-window-height "+10%"; }

    // ── 焦点移动 ──────────────────────────────────────────────
    Mod+H { focus-column-or-monitor-left; }
    Mod+K { focus-window-or-workspace-up; }
    Mod+J { focus-window-or-workspace-down; }
    Mod+L { focus-column-or-monitor-right; }
    Mod+Home { focus-column-first; }
    Mod+End { focus-column-last; }

    // ── 移动窗口 / 列 ─────────────────────────────────────────
    Mod+Shift+H { move-column-left-or-to-monitor-left; }
    Mod+Shift+J { move-window-down-or-to-workspace-down; }
    Mod+Shift+K { move-window-up-or-to-workspace-up; }
    Mod+Shift+L { move-column-right-or-to-monitor-right; }
    Mod+Shift+Home { move-column-to-first; }
    Mod+Shift+End { move-column-to-last; }

    // ── 工作区切换 ────────────────────────────────────────────
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }

    // ── 移动列到工作区 ────────────────────────────────────────
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }
    Mod+Shift+Page_Down { move-workspace-down; }
    Mod+Shift+Page_Up { move-workspace-up; }

    // ── 多显示器 ──────────────────────────────────────────────
    Mod+Ctrl+H { focus-monitor-left; }
    Mod+Ctrl+L { focus-monitor-right; }
    Mod+Ctrl+Shift+H { move-column-to-monitor-left; }
    Mod+Ctrl+Shift+L { move-column-to-monitor-right; }

    // ── 列 / 窗口吞噬与弹出 ───────────────────────────────────
    Mod+BracketLeft { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }

    // ── 截图 / 录屏 ───────────────────────────────────────────
    Mod+Shift+S hotkey-overlay-title="SnapShot Area" { spawn-sh "noctalia msg screenshot-region"; }
    Mod+Ctrl+S hotkey-overlay-title="Annotate Screen" { spawn-sh "noctalia msg screenshot-annotate"; }
    Mod+F12 hotkey-overlay-title="SnapShot Window" { screenshot-window; }
    Mod+Shift+F12 hotkey-overlay-title="SnapShot Screen" { screenshot-screen; }
    Mod+Shift+Ctrl+S hotkey-overlay-title="SnapShot UI" { screenshot; }

    // ── 启动器 / 面板（noctalia v5 IPC，原来的 dms ipc call 一一对应）──
    Mod+Space hotkey-overlay-title="Launcher" { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+Shift+Space hotkey-overlay-title="Control Center" { spawn-sh "noctalia msg panel-toggle control-center"; }
    Mod+E hotkey-overlay-title="File Manager" repeat=false { spawn-sh "footclient --app-id yazi_terminal -- yazi"; }
    Mod+Shift+E hotkey-overlay-title="Edit with emacs" repeat=false { spawn-sh "doom +everywhere"; }
    Mod+I hotkey-overlay-title="System settings" { spawn-sh "noctalia msg settings-toggle"; }
    Mod+W hotkey-overlay-title="Select a Wallpaper" { spawn-sh "noctalia msg panel-toggle wallpaper"; }
    Mod+Shift+Right { spawn "noctalia" "msg" "wallpaper-next"; }
    Mod+Shift+Left { spawn "noctalia" "msg" "wallpaper-previous"; }
    // Mod+P 取色：noctalia v5 没有对应 IPC（原来的 dms color pick）。
    // 想保留这个功能就装个独立取色器（如 hyprpicker），然后在这里 spawn 它。
    Mod+Shift+V hotkey-overlay-title="Open Clipboard" { spawn-sh "noctalia msg panel-toggle clipboard"; }
    Mod+Ctrl+Alt+B hotkey-overlay-title="Toggle Status Bar" { spawn-sh "noctalia msg bar-toggle"; }
    // dms 的 alttab.kdl 由运行时生成，弃用后这条改成 noctalia 自带的窗口切换器
    // （按住 Alt 后 Tab/Shift+Tab 在 noctalia 的界面里切换，松开 Alt 或回车确认）
    Alt+Tab hotkey-overlay-title="Window Switcher" { spawn-sh "noctalia msg window-switcher"; }

    // ── 锁屏 / 电源 ───────────────────────────────────────────
    Ctrl+Alt+L hotkey-overlay-title="Lock Screen" { spawn-sh "~/.config/niri/scripts/lock.sh"; }
    Ctrl+Alt+Delete hotkey-overlay-title="Power Menu" { spawn-sh "noctalia msg panel-toggle session"; }
    Ctrl+Alt+P { power-off-monitors; }
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    // ── 切换或启动应用 ────────────────────────────────────────
    // Mod+2 { spawn-sh "~/.config/niri/scripts/switch.sh com.tmux.ghostty 'ghostty --class=com.tmux.ghostty -e  tmux new-session -A -s main' "; }
    Mod+8 { spawn-sh "~/.config/niri/scripts/switch.sh zen zen-browser"; }
    Mod+9 { spawn-sh "~/.config/niri/scripts/switch.sh logseq logseq"; }
    Mod+D { spawn-sh "~/.config/niri/scripts/switch.sh 'DBeaver Enterprise' dbeaver-ee"; }
    Mod+N { spawn-sh "~/.config/niri/scripts/switch.sh Emacs 'emacsclient --alternate-editor= --create-frame'"; }
}
