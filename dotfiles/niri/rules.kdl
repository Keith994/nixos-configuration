window-rule {
    background-effect {
        blur true
    }
}
window-rule {
   match is-floating=true
   focus-ring {
        width 2
        // active-color "#9b0000"
        inactive-color "#505050"
       active-gradient from="#80c8ff" to="#9b0000" angle=45
    }
   // baba-is-float true // 会上下轻微浮动
}

window-rule {
    match title="图片和视频"
    match title="朋友圈"
    match title="微信"
    exclude  app-id="wechat"
    open-floating true
}

window-rule {
    match app-id="org\\.wezfurlong\\.wezterm"
    match app-id="Alacritty"
    match app-id="com\\.mitchellh\\.ghostty"
    match app-id="kitty"
    default-column-width {
     proportion 0.555
    }
}
window-rule {
    match app-id="xyz\\.chatboxapp\\.app"
    match app-id="obsidian"
    default-column-width {
     proportion 0.50
    }
}
window-rule {
    opacity 0.90
}
window-rule {
    match is-active=false
    opacity 0.80
}

window-rule {
    match app-id=".*fcitx5.*"
    match app-id="firefox" title="我的足迹"
    match app-id="firefox$" title="画中画"
    match app-id="xarchiver"
    match app-id="firefox$" title="^Picture-in-Picture$"
    open-floating true
}

// workspace 直接叫数字。"1" "2" "3" 是名字，不是索引 —— niri 的索引只是「当前位置」，
// 只有 focus-workspace 1 / move-column-to-workspace 1 这类动作才按索引，且会随排列变化。
// 声明顺序 = 它们在显示器上的排列顺序；名字声明在这里，workspace 就一直存在（空着也不消失）。
workspace "1" {
    open-on-output "eDP-1"
}

workspace "2" {
    open-on-output "eDP-1"
}

workspace "3" {
    open-on-output "eDP-1"
}

window-rule {
    match app-id="com.tmux.ghostty"
    open-on-workspace "2"
    open-maximized false
}

window-rule {
    // google-chrome 打开在 workspace 3。open-on-workspace 匹配的是上面的名字 "3"
    // （不是索引 3），必须写成字符串；写成裸数字 3 会直接解析报错。
    match app-id="firefox"
    match app-id="google-chrome"
    open-on-workspace "3"
    open-maximized true
}

window-rule {
    match app-id="^com\\.obsproject\\.Studio$"
    min-width 876
}

window-rule {
    match app-id="^dropdown$"
    open-floating true
    // 锚定到屏幕的上边缘。
    default-floating-position x=0 y=0 relative-to="top"
    // 屏幕高度的一半。
    default-window-height {
        proportion 0.55
    }
    // 屏幕宽度的 80%。
    default-column-width {
        proportion 0.93
    }
}
window-rule {
    match title="^致景科技会议$"
    match app-id="Meeting"
    // open-floating false
    // block-out-from "screencast"
    open-focused false
    // Open it as floating.
    open-floating true
    // Anchor to the top edge of the screen.
    default-floating-position x=0 y=0 relative-to="top-left"
}
window-rule {
    match app-id="wechat"
    //解决搜索框失去焦点问题
    open-focused false
}
window-rule {
    match app-id="terminal_app"
    match app-id="btop_terminal"
    match app-id="yazi_terminal"
    open-floating true
    default-window-height {
        proportion 0.93
    }
    default-column-width {
        proportion 0.93
    }
}

// imv / satty：看图、标注这类「看一眼就关」的窗口不占列，开着浮动。
// app-id 是在跑着的会话里实测的（niri msg --json windows）：imv 上报 "imv"，
// satty 0.20.1 用的是 GTK application id "com.gabm.satty"。
window-rule {
    match app-id="imv"
    match app-id="com\\.gabm\\.satty"
    open-floating true
    default-window-height {
        proportion 0.8
    }
    default-column-width {
        proportion 0.8
    }
}
