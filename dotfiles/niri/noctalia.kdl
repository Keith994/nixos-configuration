// noctalia v5 需要在 niri 侧声明的规则（原来由 dms 运行时生成的那几个 include 的替代）。
// 官方说明：https://docs.noctalia.dev/noctalia/compositor-settings/niri/
// 注意：这里出现的 namespace 都是 noctalia 自己起的名字，不要改成 dms:*。

// 窗口圆角 + 裁剪。沿用 dms/layout.kdl 里的取值，保持观感不变。
window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
    tiled-state true
    draw-border-with-background false
}

// noctalia 的设置窗口（app-id 固定为 dev.noctalia.Noctalia）以浮动窗口打开
window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 920; }
}

// 概览背景（Mod+A）用 noctalia 的模糊背景层，对应配置里的 [backdrop] enabled = true
layer-rule {
    match namespace="^noctalia-backdrop"
    place-within-backdrop true
}

// 工作区底色透明，让 noctalia 的壁纸层透出来（dms/colors.kdl 里也是这么设的）
layout {
    background-color "transparent"
}

// noctalia 会按 ext-background-effects 自己上报模糊区域，关掉 xray 更接近真实毛玻璃。
// 模糊是 niri 26.04 才有的能力，本机 niri 就是 26.04。
layer-rule {
    match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
    background-effect {
        xray false
    }
}

// 窗口切换器（Alt+Tab）整块模糊
layer-rule {
    match namespace="noctalia-window-switcher"
    background-effect {
        blur true
        xray false
    }
}
