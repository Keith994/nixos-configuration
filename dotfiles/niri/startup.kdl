spawn-sh-at-startup "fcitx5 -r -d"
// noctalia v5：bar / 通知 / 剪贴板 / 锁屏 / OSD 全在它里面，polkit 认证仍由上面那条 polkit-gnome 负责
// （所以 dotfiles/noctalia/config.toml 里 [shell] polkit_agent 保持默认关闭，避免两个 agent 抢 PolicyKit1）
spawn-at-startup "noctalia"
spawn-at-startup "clash-verge"
spawn-sh-at-startup "foot --server"
