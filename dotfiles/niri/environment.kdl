environment {
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    QT_QPA_PLATFORMTHEME "gtk3"
    QT_QPA_PLATFORMTHEME_QT6 "gtk3"
    XDG_MENU_PREFIX "nixos-"
    // fcitx5 由 modules/nixos/fcitx5.nix 以 waylandFrontend = true 启用：
    // Wayland 应用通过 text-input / input-method 协议直接和 fcitx5 通信，
    // 此时不应再设置 QT_IM_MODULE / GTK_IM_MODULE / SDL_IM_MODULE，
    // 否则会绕过 Wayland 输入法前端（fcitx5 官方也建议 unset）。
    // XIM（XWayland 应用）的服务名是 fcitx，不是 fcitx5。
    XMODIFIERS "@im=fcitx"
    XDG_SESSION_TYPE "wayland"
    // XDG_CURRENT_DESKTOP "niri"
    // _JAVA_AWT_WM_NONREPARENTING "1"
    EDITOR "nvim"
    LANG "zh_CN.UTF-8"
    LC_ALL "en_US.UTF-8"
    // CLUTTER_BACKEND "wayland"
    // GDK_BACKEND "wayland,x11,*"
    // QT_QPA_PLATFORM "wayland"

    // QT_QUICK_CONTROLS_STYLE "org.hyprland.style"
    // QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
    MOZ_ENABLE_WAYLAND "1"
    MOZ_WEBRENDER "1"
    // QT_AUTO_SCREEN_SCALE_FACTOR "1"
    // SDL_VIDEODRIVER "wayland"
    // VK_ICD_FILENAMES "/usr/share/vulkan/icd.d/radeon_icd.x86_64.json"
    // AMD_VULKAN_ICD "RADV" // default editor
    //SACLE
    // GDK_DPI_SCALE "1.67"
    QT_SCALE_FACTOR "1"
    GDK_SCALE "1"
}
