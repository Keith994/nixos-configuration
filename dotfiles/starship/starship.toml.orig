# ─────────────────────────────────────────────────────────────────────────────
# 这是 starship 配置的**原始手写版本**（.orig，进版本库，改它不会影响正在跑的提示符）。
#
# 真正生效的是同目录的 `starship.toml`（`~/.config/starship.toml` 的 out-of-store 软链指向它）。
# noctalia 的 starship 模板（state 层 builtin_ids 里的 "starship"）每次换壁纸/主题都会改写它：
# 把 `palette = ...` 那行换成 `palette = "noctalia"`，并在文件末尾追加一段
# `# >>> NOCTALIA STARSHIP PALETTE >>>` … `# <<< NOCTALIA STARSHIP PALETTE <<<`。
# 所以那个文件被 .gitignore 忽略，只在这份 .orig 里维护手写内容。
#
# 还原 / 新机器（`~/.config/starship.toml` 缺目标时软链是悬空的，starship 会**静默**回退到
# 内置默认配置，看着就像"配置没生效" —— 见 AGENTS.md 第 5、8 节）：
#
#     cp dotfiles/starship/starship.toml.orig dotfiles/starship/starship.toml
#
# 下面那份 [palettes.catppuccin_mocha] 是 noctalia 注入之前的调色板；注入后 `palette` 会指向
# "noctalia"，这份就成了备用（把 noctalia 从模板列表里去掉再还原时就用它）。
# ─────────────────────────────────────────────────────────────────────────────
# Don't print a new line at the start of the prompt
add_newline = true
# Pipes ╰─ ╭─
# Powerline symbols                                     
# Wedges 🭧🭒 🭣🭧🭓
# Random noise 🬖🬥🬔🬗

# format = """
# $cmd_duration$username$hostname $directory $git_branch
# $character
# """
palette = 'catppuccin_mocha'

format = """
$hostname$directory$git_branch
$character
"""

# Replace the "❯" symbol in the prompt with "➜"
[character]                            # The name of the module we are configuring is "character"
success_symbol = "[](bold fg:green) "
error_symbol = "[󰅙](bold fg:red) "

# Disable the package module, hiding it from the prompt completely
[package]
disabled = true

[git_branch]
style = "bg: green"
symbol = "󰘬"
truncation_length = 30
truncation_symbol = ""
format = "[](bold fg:green)[ $symbol $branch(:$remote_branch)](fg:#010101 bg:green)[ ](bold fg:green)"

[git_commit]
commit_hash_length = 4
tag_symbol = " "

[git_state]
format = '[\($state( $progress_current of $progress_total)\)]($style) '
cherry_pick = "[🍒 PICKING](bold red)"

[git_status]
conflicted = "🏳 "
# ahead = " 🏎💨 "
# behind = " 😰 "
# diverged = " 😵 "
# untracked = " 🤷 ‍"
stashed = " "
modified = "[ $count](yellow)"
staged = '[ $count](green)'
renamed = "[󰑕 $count](cyan)"
deleted = "[ $count](red)"

[hostname]
ssh_only = true
format =  "[](bold fg:cyan )[$hostname](bg:cyan bold fg:#010101)[](bold fg:cyan )"
trim_at = ".companyname.com"
disabled = false

[line_break]
disabled = false

[memory_usage]
disabled = true
threshold = -1
symbol = " "
style = "bold dimmed green"

[time]
disabled = true
format = '🕙[\[ $time \]]($style) '
time_format = "%T"

[directory]
home_symbol = " ~"
read_only = "  "
style = "bg:peach fg:crust"
# style = "bg:peach fg:crust"
truncation_length = 6
truncation_symbol = "••/"
format = '[](bold fg:peach)[$path ]($style)[](bold fg:peach)'


# [directory.substitutions]
# "Desktop" = "  "
# "Documents" = "  "
# "Downloads" = "  "
# "Music" = " 󰎈"
# "Pictures" = "  "
# "Videos" = "  "
[cmd_duration]
min_time = 0
format = '[](bold fg:yellow)[󰣇 $duration](bold bg:yellow fg:#010101)[](bold fg:yellow) '

[python]
symbol = ""
format = '[ $symbol $version ]($style)'

[golang]
symbol = " "
format = '[$symbol $version ]($style)'

[java]
symbol = ""
format = '[$symbol $version ]($style)'

[rust]
symbol = ""
format = '[$symbol $version ]($style)'

[palettes.catppuccin_mocha]
rosewater = "#f5e0dc"
flamingo = "#f2cdcd"
pink = "#f5c2e7"
mauve = "#cba6f7"
red = "#f38ba8"
maroon = "#eba0ac"
peach = "#fab387"
yellow = "#f9e2af"
green = "#a6e3a1"
teal = "#94e2d5"
sky = "#89dceb"
sapphire = "#74c7ec"
blue = "#89b4fa"
lavender = "#b4befe"
text = "#cdd6f4"
subtext1 = "#bac2de"
subtext0 = "#a6adc8"
overlay2 = "#9399b2"
overlay1 = "#7f849c"
overlay0 = "#6c7086"
surface2 = "#585b70"
surface1 = "#45475a"
surface0 = "#313244"
base = "#1e1e2e"
mantle = "#181825"
crust = "#11111b"

