# Theme
config-file = themes/dankcolors

# Font settings
font-family = Maple Mono NF CN
font-size = 12
adjust-cell-height = 5

# Cursor settings
cursor-style = block
adjust-cursor-thickness = 1
shell-integration-features = no-cursor
shell-integration = fish
working-directory = "home"
custom-shader = shader/cursor_warp.glsl
quit-after-last-window-closed = "true"
# quit-after-last-window-closed-delay = "30m"
gtk-single-instance = "true"
# linux-cgroup = "single-instance"
# linux-cgroup-memory-limit = "536870912"
# linux-cgroup-processes-limit = 100
confirm-close-surface = "false"

# tab settings
gtk-wide-tabs = false
gtk-tabs-location = bottom

# Mouse Settings
mouse-scroll-multiplier = 1

# Window settings
window-padding-x = 2
window-padding-y = 2
# window-width = 140
# window-height = 35
#window-save-state = always

# auto-update-channel = "tip"
#cursor-style = "bar"
mouse-hide-while-typing = "false"
#unfocused-split-fill = "#000000"

# Keybindings
keybind = ctrl+t=unbind
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+shift+c=copy_to_clipboard
keybind = alt+v=paste_from_clipboard
keybind = alt+c=copy_to_clipboard
keybind = ctrl+shift+]=next_tab
keybind = ctrl+shift+[=previous_tab
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+a=toggle_tab_overview

keybind = shift+PageDown=unbind
keybind = shift+PageUp=unbind

# keybind = ctrl+shift+Home=scroll_to_top
# keybind = ctrl+shift+End=scroll_to_bottom
# keybind = ctrl+shift+PageDown=scroll_page_down
# keybind = ctrl+shift+PageUp=scroll_page_up

keybind = ctrl+shift+x=close_surface
keybind = ctrl+shift+\=new_split:right
keybind = ctrl+shift+n=new_split:down
keybind = shift+alt+enter=toggle_quick_terminal

# Split navigation
keybind = ctrl+shift+k=goto_split:top
keybind = ctrl+shift+j=goto_split:bottom
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+l=goto_split:right

# Split resizing
keybind = super+ctrl+down=resize_split:down,100
keybind = super+ctrl+left=resize_split:left,100
keybind = super+ctrl+up=resize_split:up,100
keybind = super+ctrl+right=resize_split:right,100

# Make ctrl+enter act like enter. I often hit ctrl+enter by mistake and
# ghostty sends ";5;13~" characters, which is extremely annoying.
# https://github.com/ghostty-org/ghostty/discussions/3151#discussioncomment-11678064
keybind = ctrl+enter=text:\r
theme = noctalia
